MONGO_URI=mongodb://127.0.0.1:27017/rapidroutines
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=5000
FRONTEND_URL=https://rapidroutines.org
CORS_ORIGINS=https://rapidroutines.org,https://www.rapidroutines.org
TRUST_PROXY_HOPS=2
NODE_ENV=production

RESEND_API_KEY=re_replace_me
RESEND_SENDER_EMAIL=support@rapidroutines.org

GEMINI_API_KEY=replace-me

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=contact@example.com
ZOHO_SMTP_PASS=replace-me
CONTACT_TO_EMAIL=support@rapidroutines.org
CONTACT_FROM_EMAIL=contact@example.com

# test-only: set to true to keep rate limits active while NODE_ENV=test
RATE_LIMIT_IN_TESTS=
